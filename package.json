{
  "name": "barcode-tag-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "jsbarcode": "^3.12.3",
    "localforage": "^1.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win nsis --x64"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.js",
  "homepage": ".",
  "description": "Barcode Generator",
  "author": "WMPYB",
  "build": {
    "extends": null,
    "appId": "com.yourcompany.barcodegenerator",
    "productName": "Barcode Generator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
